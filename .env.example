# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration. Never expose or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Gemini configuration. M0 does not invoke Gemini.
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash

# Authoritative medical-source endpoints. These are configuration, not secrets.
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
OPENFDA_BASE_URL=https://api.fda.gov
# Optional. Do not set until openFDA usage and limits are confirmed.
OPENFDA_API_KEY=3vqVK06w81vjNWb7ns9cZNeygPEXGQouGxIwfLTR

# Server-only environment identity. Valid values: development, preview, production.
MEDIMIND_ENVIRONMENT=development
MEDIMIND_APP_URL=http://localhost:3000

# Future operational controls; no provider integration exists in M0.
UPLOAD_MAX_BYTES=10485760
CONNECTION_CODE_TTL_MINUTES=30
SIGNED_URL_TTL_SECONDS=300
